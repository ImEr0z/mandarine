<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Panel.Background" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="Panel.Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Text.Primary" Color="#FFF3F3F4" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFB0B1B8" />
    <SolidColorBrush x:Key="Tile.Background" Color="#FF37373B" />
    <SolidColorBrush x:Key="Tile.Border" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Tile.Hover" Color="#FF424247" />
    <SolidColorBrush x:Key="Tile.Pressed" Color="#FF323236" />
    <SolidColorBrush x:Key="Accent" Color="#FFFF9A3D" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#FF4D3622" />
    <SolidColorBrush x:Key="Accent.Strong" Color="#FFFFB46E" />
    <SolidColorBrush x:Key="Focus" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="Error" Color="#FFFF99A4" />
</ResourceDictionary>
