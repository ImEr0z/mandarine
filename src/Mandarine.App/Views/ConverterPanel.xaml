<Window x:Class="Mandarine.App.Views.ConverterPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mandarine.App.Views"
        Title="Mandarine"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowDrop="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}"
        FontSize="13"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
        <DataTemplate x:Key="ConvertTileTemplate" DataType="{x:Type views:ActionItem}">
            <Button Style="{StaticResource ConvertTile}"
                    ToolTip="{Binding Description}"
                    AutomationProperties.Name="{Binding Description}"
                    Click="OnTileClick" DragEnter="OnTileDragEnter" DragOver="OnTileDragOver"
                    DragLeave="OnTileDragLeave" Drop="OnTileDrop">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="4,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Visibility="{Binding NeedsInstall, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ToolRowTemplate" DataType="{x:Type views:ActionItem}">
            <Button Style="{StaticResource ToolRow}"
                    ToolTip="{Binding Description}"
                    AutomationProperties.Name="{Binding Description}"
                    Click="OnTileClick" DragEnter="OnTileDragEnter" DragOver="OnTileDragOver"
                    DragLeave="OnTileDragLeave" Drop="OnTileDrop">
                <Grid Margin="10,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                               Visibility="{Binding NeedsInstall, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <!-- 12 px transparent margin leaves room for the shadow. -->
    <Border x:Name="Card" Margin="12" Padding="12" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource Panel.Background}" BorderBrush="{DynamicResource Panel.Border}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.28" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Accent.Soft}">
                    <TextBlock x:Name="KindGlyph" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Mandarine" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Text="Déposez un fichier pour le convertir" FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Paramètres" AutomationProperties.Name="Paramètres" Click="OnSettingsClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            ToolTip="Fermer (Échap)" AutomationProperties.Name="Fermer" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- Drop zone hint -->
            <Grid x:Name="HintView" Height="132" Margin="0,12,0,0" Visibility="Collapsed">
                <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                           Stroke="{DynamicResource Text.Secondary}" Opacity="0.6" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Glissez des fichiers ici" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="puis relâchez-les sur un format" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <ScrollViewer x:Name="ActionsView" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                          Visibility="Collapsed" PreviewDragOver="OnActionsPreviewDragOver">
                <StackPanel>
                    <TextBlock x:Name="ConvertHeader" Text="Convertir en" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="ConvertList" ItemTemplate="{StaticResource ConvertTileTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="ToolsHeader" Text="Outils" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="ToolList" ItemTemplate="{StaticResource ToolRowTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <TextBlock x:Name="FooterText" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Working -->
            <StackPanel x:Name="WorkingView" Margin="0,14,0,2" Visibility="Collapsed">
                <TextBlock x:Name="WorkingText" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkingDetail" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Secondary}" />
                <ProgressBar x:Name="WorkingProgress" Height="4" Margin="0,12,0,12" Minimum="0" Maximum="1"
                             BorderThickness="0" Background="{DynamicResource Tile.Hover}" Foreground="{DynamicResource Accent}" />
                <Button Content="Annuler" Style="{StaticResource PanelButton}" HorizontalAlignment="Right" Click="OnCancelClick" />
            </StackPanel>

            <!-- Result -->
            <StackPanel x:Name="DoneView" Margin="0,14,0,2" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DoneGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="DoneTitle" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DoneDetail" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock x:Name="ErrorText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Error}" Visibility="Collapsed" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource PanelButton}" Click="OnSecondaryClick" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource PanelAccentButton}" Click="OnPrimaryClick" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
