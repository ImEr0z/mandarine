<Window x:Class="Mandarine.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de Mandarine"
        Width="640"
        Height="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        Icon="/Mandarine;component/Assets/mandarine.ico"
        FontFamily="{StaticResource TextFont}"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="CardFill" Color="#14808080" />
        <SolidColorBrush x:Key="CardStroke" Color="#33808080" />
        <SolidColorBrush x:Key="ChipFill" Color="#33808080" />

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="4,24,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource CardStroke}" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- Selectable card with a preview and a radio dot, like a picker of layouts. -->
        <Style x:Key="PreviewCard" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="180" CornerRadius="8" BorderThickness="2"
                                Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardStroke}">
                            <StackPanel>
                                <ContentPresenter Margin="0,10,0,6" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" StrokeThickness="2" />
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Hidden"
                                                 Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    </Grid>
                                    <TextBlock Text="{TemplateBinding Tag}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,16">

                <!-- ===== Ouvrir le menu ===== -->
                <TextBlock Text="Ouvrir le menu de conversion" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Geste de glisser-déposer" Style="{StaticResource Title}" />
                                <TextBlock x:Name="TriggerHint" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox x:Name="TriggerBox" Grid.Column="1" Width="230" VerticalAlignment="Top"
                                      SelectionChanged="OnTriggerChanged" AutomationProperties.Name="Déclencheur du geste">
                                <ComboBoxItem Tag="Shift" Content="Glisser + Maj" />
                                <ComboBoxItem Tag="Alt" Content="Glisser + Alt" />
                                <ComboBoxItem Tag="Ctrl" Content="Glisser + Ctrl" />
                                <ComboBoxItem Tag="ShiftTap" Content="Appuyer sur Maj (sans glisser)" />
                                <ComboBoxItem Tag="Shake" Content="Secouer le fichier" />
                                <ComboBoxItem Tag="Disabled" Content="Désactivé" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid x:Name="ExplorerOnlyRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Limiter à l'Explorateur et au Bureau" Style="{StaticResource Title}" />
                                <TextBlock Text="Ignore les fichiers glissés depuis les autres applications." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="ExplorerOnlyBox" Grid.Column="1" MinWidth="0" Click="OnChanged"
                                      AutomationProperties.Name="Limiter à l'Explorateur et au Bureau" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Raccourci clavier" Style="{StaticResource Title}" />
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                                           Text="Sélectionnez des fichiers dans l'Explorateur ou sur le Bureau, puis appuyez sur le raccourci." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource Card}" Padding="8,5" MinWidth="230" Margin="0,0,8,0" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="HotkeyChips" Orientation="Horizontal" VerticalAlignment="Center" />
                                        <Button x:Name="HotkeyRecord" Grid.Column="1" Content="Modifier" Margin="10,0,0,0"
                                                Click="OnHotkeyRecord" LostKeyboardFocus="OnHotkeyBlur"
                                                AutomationProperties.Name="Modifier le raccourci clavier" />
                                    </Grid>
                                </Border>
                                <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Width="34" Padding="0" VerticalAlignment="Stretch"
                                        Click="OnHotkeyClear" ToolTip="Supprimer le raccourci"
                                        AutomationProperties.Name="Supprimer le raccourci clavier" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Affichage ===== -->
                <TextBlock Text="Affichage" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,16,16,4">
                            <RadioButton x:Name="WheelRadio" GroupName="Style" Style="{StaticResource PreviewCard}" Tag="Roue de formats" AutomationProperties.Name="Roue de formats" Checked="OnChanged">
                                <Canvas Width="140" Height="90">
                                    <Ellipse Canvas.Left="58" Canvas.Top="33" Width="24" Height="24" Fill="{StaticResource ChipFill}" />
                                    <Ellipse Canvas.Left="94" Canvas.Top="37" Width="16" Height="16" Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    <Ellipse Canvas.Left="78" Canvas.Top="64.7" Width="16" Height="16" Fill="{StaticResource ChipFill}" />
                                    <Ellipse Canvas.Left="46" Canvas.Top="64.7" Width="16" Height="16" Fill="{StaticResource ChipFill}" />
                                    <Ellipse Canvas.Left="30" Canvas.Top="37" Width="16" Height="16" Fill="{StaticResource ChipFill}" />
                                    <Ellipse Canvas.Left="46" Canvas.Top="9.3" Width="16" Height="16" Fill="{StaticResource ChipFill}" />
                                    <Ellipse Canvas.Left="78" Canvas.Top="9.3" Width="16" Height="16" Fill="{StaticResource ChipFill}" />
                                </Canvas>
                            </RadioButton>
                            <RadioButton x:Name="ListRadio" GroupName="Style" Style="{StaticResource PreviewCard}" Tag="Liste" AutomationProperties.Name="Liste" Margin="0" Checked="OnChanged">
                                <Canvas Width="140" Height="90">
                                    <Rectangle Canvas.Left="15" Canvas.Top="8" Width="110" Height="14" RadiusX="4" RadiusY="4" Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    <Rectangle Canvas.Left="15" Canvas.Top="29" Width="110" Height="14" RadiusX="4" RadiusY="4" Fill="{StaticResource ChipFill}" />
                                    <Rectangle Canvas.Left="15" Canvas.Top="50" Width="110" Height="14" RadiusX="4" RadiusY="4" Fill="{StaticResource ChipFill}" />
                                    <Rectangle Canvas.Left="15" Canvas.Top="71" Width="110" Height="14" RadiusX="4" RadiusY="4" Fill="{StaticResource ChipFill}" />
                                </Canvas>
                            </RadioButton>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Sons d'interface" Style="{StaticResource Title}" />
                                <TextBlock Text="Survol de la roue et fin de conversion." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="SoundsBox" Grid.Column="1" MinWidth="0" Click="OnChanged" AutomationProperties.Name="Sons d'interface" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=SoundsBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Son de survol" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="&#xE768;" FontFamily="{StaticResource IconFont}"
                                    Width="34" Height="32" Padding="0" Click="OnPlayHover" ToolTip="Écouter"
                                    AutomationProperties.Name="Écouter le son de survol" />
                            <ComboBox x:Name="HoverSoundBox" Grid.Column="1" Width="230" Margin="0,0,42,0" SelectionChanged="OnHoverSoundChanged"
                                      AutomationProperties.Name="Son de survol">
                                <ComboBoxItem Tag="Soft" Content="Doux" />
                                <ComboBoxItem Tag="Glass" Content="Verre" />
                                <ComboBoxItem Tag="Drop" Content="Goutte" />
                                <ComboBoxItem Tag="Silk" Content="Soie" />
                                <ComboBoxItem Tag="Off" Content="Aucun" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=SoundsBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Son de fin de conversion" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="&#xE768;" FontFamily="{StaticResource IconFont}"
                                    Width="34" Height="32" Padding="0" Click="OnPlayDone" ToolTip="Écouter"
                                    AutomationProperties.Name="Écouter le son de fin de conversion" />
                            <ComboBox x:Name="DoneSoundBox" Grid.Column="1" Width="230" Margin="0,0,42,0" SelectionChanged="OnDoneSoundChanged"
                                      AutomationProperties.Name="Son de fin de conversion">
                                <ComboBoxItem Tag="Soft" Content="Doux" />
                                <ComboBoxItem Tag="Glass" Content="Verre" />
                                <ComboBoxItem Tag="Drop" Content="Goutte" />
                                <ComboBoxItem Tag="Silk" Content="Soie" />
                                <ComboBoxItem Tag="Off" Content="Aucun" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Fichiers créés ===== -->
                <TextBlock Text="Fichiers créés" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="16,12">
                            <TextBlock Text="Emplacement" Style="{StaticResource Title}" />
                            <RadioButton x:Name="NextToSourceRadio" GroupName="Output" Content="À côté du fichier d'origine" Margin="0,8,0,0" Checked="OnChanged" />
                            <RadioButton x:Name="FolderRadio" GroupName="Output" Content="Dans ce dossier :" Margin="0,6,0,0" Checked="OnChanged" />
                            <Grid Margin="28,6,0,0" IsEnabled="{Binding IsChecked, ElementName=FolderRadio}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" TextChanged="OnFolderTextChanged" AutomationProperties.Name="Dossier de destination" />
                                <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Click="OnBrowseFolder" />
                            </Grid>
                            <TextBlock Text="Les fichiers existants ne sont jamais écrasés : « photo (2).png » est créé à la place."
                                       Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Qualité des images" Style="{StaticResource Title}" />
                                <TextBlock Text="JPEG, WebP et AVIF." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="QualitySlider" Width="200" Minimum="40" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnQualityChanged"
                                        AutomationProperties.Name="Qualité des images" />
                                <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=QualitySlider, StringFormat={}{0:0}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Réglages par type de fichier ===== -->
                <TextBlock Text="Réglages par type de fichier" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Type de fichier" Style="{StaticResource Title}" />
                                <TextBlock Text="Ce qui est vide ou à 0 reprend le réglage général." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox x:Name="KindBox" Grid.Column="1" Width="230" VerticalAlignment="Top"
                                      SelectionChanged="OnKindChanged" AutomationProperties.Name="Type de fichier">
                                <ComboBoxItem Tag="Images" Content="Images" IsSelected="True" />
                                <ComboBoxItem Tag="Pdfs" Content="PDF" />
                                <ComboBoxItem Tag="Others" Content="Autres fichiers" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dossier de destination" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <TextBox x:Name="KindFolderBox" Grid.Column="1" Width="230" TextChanged="OnKindFieldChanged"
                                     AutomationProperties.Name="Dossier de destination de ce type" />
                        </Grid>
                        <Border x:Name="KindQualityDivider" Style="{StaticResource Divider}" />
                        <Grid x:Name="KindQualityRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Qualité" Style="{StaticResource Title}" />
                                <TextBlock Text="De 1 à 100 (JPEG, WebP, AVIF)." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBox x:Name="KindQualityBox" Grid.Column="1" Width="90" TextChanged="OnKindFieldChanged"
                                     AutomationProperties.Name="Qualité de ce type" />
                        </Grid>
                        <Border x:Name="KindSizeDivider" Style="{StaticResource Divider}" />
                        <Grid x:Name="KindSizeRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Taille maximale" Style="{StaticResource Title}" />
                                <TextBlock Text="Plus grand côté en pixels ; les petites images ne sont pas agrandies." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBox x:Name="KindSizeBox" Grid.Column="1" Width="90" TextChanged="OnKindFieldChanged"
                                     AutomationProperties.Name="Taille maximale de ce type" />
                        </Grid>
                        <Border x:Name="KindDpiDivider" Style="{StaticResource Divider}" />
                        <Grid x:Name="KindDpiRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Résolution (DPI)" Style="{StaticResource Title}" />
                                <TextBlock Text="Pour les pages converties en image. 150 par défaut." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBox x:Name="KindDpiBox" Grid.Column="1" Width="90" TextChanged="OnKindFieldChanged"
                                     AutomationProperties.Name="Résolution des pages PDF" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Ajout au nom" Style="{StaticResource Title}" />
                                <TextBlock Text="« _web » donne « photo_web.png »." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBox x:Name="KindSuffixBox" Grid.Column="1" Width="230" TextChanged="OnKindFieldChanged"
                                     AutomationProperties.Name="Texte ajouté au nom des fichiers de ce type" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Windows ===== -->
                <TextBlock Text="Windows" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lancer Mandarine à l'ouverture de session" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <CheckBox x:Name="StartupBox" Grid.Column="1" MinWidth="0" Click="OnChanged" AutomationProperties.Name="Lancer à l'ouverture de session" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=StartupBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Démarrer réduit" Style="{StaticResource Title}" />
                                <TextBlock Text="Dans la zone de notification, sans message." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="StartMinimizedBox" Grid.Column="1" MinWidth="0" Click="OnChanged" AutomationProperties.Name="Démarrer réduit" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="« Convertir avec Mandarine » dans le clic droit" Style="{StaticResource Title}" />
                                <TextBlock Text="Ajoute aussi l'entrée à « Envoyer vers ». Sous Windows 11, elle se trouve dans « Afficher plus d'options »."
                                           Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="ContextMenuBox" Grid.Column="1" MinWidth="0" Click="OnChanged" AutomationProperties.Name="Ajouter au clic droit" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hidden in this version: images, PDF, data and archives need no external tool. -->
                <Grid x:Name="ToolsGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="FFmpeg" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="FfmpegStatus" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Installer" Margin="8,0,0,0" Tag="Ffmpeg" Click="OnInstallTool" x:Name="FfmpegInstall" />
                    <Button Grid.Column="3" Content="Choisir…" Margin="8,0,0,0" Tag="Ffmpeg" Click="OnPickTool" />

                    <TextBlock Grid.Row="1" Text="LibreOffice" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="LibreOfficeStatus" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Installer" Margin="8,8,0,0" Tag="LibreOffice"
                            Click="OnInstallTool" x:Name="LibreOfficeInstall" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Choisir…" Margin="8,8,0,0" Tag="LibreOffice" Click="OnPickTool" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="0" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fermer" IsCancel="True" IsDefault="True" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
