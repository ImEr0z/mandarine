<Window x:Class="Mandarine.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de Mandarine"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        Icon="/Mandarine;component/Assets/mandarine.ico"
        FontFamily="{StaticResource TextFont}">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,8,28,24">
        <TextBlock Text="Geste" Style="{StaticResource Section}" />
        <TextBlock Text="Ouvrir le menu de conversion en faisant glisser un fichier et en…" Margin="0,0,0,6" />
        <ComboBox x:Name="TriggerBox" SelectionChanged="OnTriggerChanged" AutomationProperties.Name="Déclencheur du geste">
            <ComboBoxItem Tag="Shift" Content="maintenant la touche Maj" />
            <ComboBoxItem Tag="Alt" Content="maintenant la touche Alt" />
            <ComboBoxItem Tag="Ctrl" Content="maintenant la touche Ctrl" />
            <ComboBoxItem Tag="Shake" Content="secouant le fichier de gauche à droite" />
            <ComboBoxItem Tag="Disabled" Content="(désactivé : clic droit et raccourci uniquement)" />
        </ComboBox>
        <TextBlock x:Name="TriggerHint" Style="{StaticResource Hint}" />
        <CheckBox x:Name="ExplorerOnlyBox" Margin="0,10,0,0"
                  Content="Seulement depuis l'Explorateur de fichiers et le Bureau" />

        <TextBlock Text="Raccourci clavier" Style="{StaticResource Section}" />
        <TextBlock Text="Sélectionnez des fichiers dans l'Explorateur ou sur le Bureau, puis appuyez sur :" Margin="0,0,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.Name="Raccourci clavier de la roue"
                     AutomationProperties.HelpText="Cliquez puis appuyez sur la combinaison voulue" />
            <Button Grid.Column="1" Content="Désactiver" Margin="8,0,0,0" Click="OnHotkeyClear" />
        </Grid>
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                   Text="Cliquez dans la case puis appuyez sur la combinaison (au moins Ctrl, Alt ou Win, ou une touche F1 à F24)." />

        <TextBlock Text="Affichage" Style="{StaticResource Section}" />
        <RadioButton x:Name="WheelRadio" GroupName="Style" Content="Roue de formats (comme Tangerine)" />
        <RadioButton x:Name="ListRadio" GroupName="Style" Content="Liste" Margin="0,6,0,0" />
        <CheckBox x:Name="SoundsBox" Margin="0,10,0,0" Content="Petits sons d'interface (survol de la roue, fin de conversion)" />

        <TextBlock Text="Fichiers créés" Style="{StaticResource Section}" />
        <RadioButton x:Name="NextToSourceRadio" GroupName="Output" Content="À côté du fichier d'origine" />
        <RadioButton x:Name="FolderRadio" GroupName="Output" Content="Dans ce dossier :" Margin="0,6,0,0" />
        <Grid Margin="28,6,0,0" IsEnabled="{Binding IsChecked, ElementName=FolderRadio}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" AutomationProperties.Name="Dossier de destination" />
            <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Click="OnBrowseFolder" />
        </Grid>
        <TextBlock Text="Les fichiers existants ne sont jamais écrasés : « photo (2).png » est créé à la place."
                   Style="{StaticResource Hint}" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Qualité JPEG, WebP, AVIF" VerticalAlignment="Center" />
            <Slider x:Name="QualitySlider" Grid.Column="1" Margin="12,0" Minimum="40" Maximum="100"
                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    AutomationProperties.Name="Qualité des images" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding Value, ElementName=QualitySlider, StringFormat={}{0:0}}" />
        </Grid>

        <TextBlock Text="Windows" Style="{StaticResource Section}" />
        <CheckBox x:Name="StartupBox" Content="Lancer Mandarine à l'ouverture de session" />
        <CheckBox x:Name="StartMinimizedBox" Margin="28,8,0,0" IsEnabled="{Binding IsChecked, ElementName=StartupBox}"
                  Content="Démarrer réduit dans la zone de notification (sans message)" />
        <CheckBox x:Name="ContextMenuBox" Margin="0,8,0,0"
                  Content="Ajouter « Convertir avec Mandarine » au clic droit et à « Envoyer vers »" />
        <TextBlock Text="Sous Windows 11, l'entrée se trouve dans « Afficher plus d'options »."
                   Style="{StaticResource Hint}" Margin="28,2,0,0" />

        <!-- Hidden in this version: images, PDF, data and archives need no external tool. -->
        <TextBlock Text="Outils complémentaires" Style="{StaticResource Section}" Visibility="Collapsed" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="Collapsed"
                   Text="Gratuits et open source. Sans eux, les images, PDF, données et archives fonctionnent déjà." />
        <Grid x:Name="ToolsGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="FFmpeg" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="FfmpegStatus" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Installer" Margin="8,0,0,0" Tag="Ffmpeg" Click="OnInstallTool" x:Name="FfmpegInstall" />
            <Button Grid.Column="3" Content="Choisir…" Margin="8,0,0,0" Tag="Ffmpeg" Click="OnPickTool" />

            <TextBlock Grid.Row="1" Text="LibreOffice" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="LibreOfficeStatus" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Row="1" Grid.Column="2" Content="Installer" Margin="8,8,0,0" Tag="LibreOffice"
                    Click="OnInstallTool" x:Name="LibreOfficeInstall" />
            <Button Grid.Row="1" Grid.Column="3" Content="Choisir…" Margin="8,8,0,0" Tag="LibreOffice" Click="OnPickTool" />
        </Grid>

        <Grid Margin="0,28,0,0">
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" MinWidth="96" />
                <Button Content="Enregistrer" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="OnSave" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
