<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Product>Mandarine</Product>
    <Copyright>Mandarine contributors</Copyright>
    <!-- PDFtoImage lists every platform it supports, which net8.0 (any OS) cannot prove statically. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
